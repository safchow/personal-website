# Local: mongodb_replica (docker-compose) or Atlas
DATABASE_URL="mongodb://localhost:27017/website?directConnection=true"
# Railway: ${{mongo1.MONGO_PRIVATE_URL}}/website
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/website?retryWrites=true&w=majority

CLIENT_URL="http://localhost:5173"
PORT=8080

# Required in production for analytics read endpoints.
ADMIN_API_KEY=""

# Analytics hardening.
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_WRITE_LIMIT_PER_MINUTE=60
ANALYTICS_READ_LIMIT_PER_MINUTE=30
