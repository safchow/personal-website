# App database (development + production): MongoDB Atlas.
# Provision a cluster + least-privilege DB user, then use the SRV string:
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/website?retryWrites=true&w=majority"
# Railway: set the same Atlas SRV string as DATABASE_URL.

CLIENT_URL="http://localhost:5173"
PORT=8080

# Raw analytics events are deleted after this many days via a MongoDB TTL index
# on the `events.timestamp` field (applied at backend startup).
# Default 730 (2 years) keeps year-over-year trends while bounding storage growth.
ANALYTICS_RETENTION_DAYS=730

# Admin password gating the analytics READ endpoints (GET /api/events,
# GET /api/events/stats). Store only the SHA-256 hex of your password, never the
# plaintext. Generate with:  printf '%s' 'your-password' | shasum -a 256
# Callers authenticate with the `x-admin-password` header (or ?password=).
# If unset, reads are open in dev/test and return 503 in production.
ANALYTICS_ADMIN_PASSWORD_HASH=

# Note: the backend e2e suite (`pnpm test:backend:e2e`) does NOT use Atlas. It
# runs against a local single-node replica set started with `pnpm docker:up`
# (mongodb://localhost:27017/website_test) for isolated, disposable test data.
